<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>com.facebook.presto:presto-parser</id>
    <version>0.122</version>
    <type>jar</type>
    <name>presto-parser</name>
    <summary>Presto</summary>
    <website>https://github.com/facebook/presto/presto-parser</website>
    <licenses>
        <license>
            <name>Apache License 2.0</name>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <id>javax.inject:javax.inject</id>
            <version>1</version>
        </dependency>
        <dependency>
            <id>com.google.code.findbugs:annotations</id>
            <version>2.0.3</version>
        </dependency>
        <dependency>
            <id>com.fasterxml.jackson.core:jackson-core</id>
            <version>2.4.4</version>
        </dependency>
        <dependency>
            <id>com.fasterxml.jackson.core:jackson-databind</id>
            <version>2.4.4</version>
        </dependency>
        <dependency>
            <id>io.airlift:slice</id>
            <version>0.15</version>
        </dependency>
        <dependency>
            <id>com.google.guava:guava</id>
            <version>18.0</version>
        </dependency>
        <dependency>
            <id>org.antlr:antlr4-runtime</id>
            <version>4.5.1</version>
        </dependency>
    </dependencies>
    <properties/>
</extension>
