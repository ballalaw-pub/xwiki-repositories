<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>commons-logging:commons-logging</id>
    <version>1.2</version>
    <type>jar</type>
    <name>Apache Commons Logging</name>
    <summary>Apache Commons Logging is a thin adapter allowing configurable bridging to other,
    well known logging systems.</summary>
    <website>http://commons.apache.org/proper/commons-logging/</website>
    <authors>
        <author>
            <name>Juozas Baliuka</name>
