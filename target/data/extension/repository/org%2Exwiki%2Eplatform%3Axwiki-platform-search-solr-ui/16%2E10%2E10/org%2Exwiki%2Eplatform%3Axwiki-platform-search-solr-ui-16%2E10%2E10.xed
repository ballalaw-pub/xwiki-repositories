<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.xwiki.platform:xwiki-platform-search-solr-ui</id>
    <version>16.10.10</version>
    <type>xar</type>
    <name>Solr Search Application</name>
    <summary>Allows searching on the wiki using Apache Solr</summary>
    <website>https://extensions.xwiki.org?id=org.xwiki.platform:xwiki-platform-search-solr-ui:16.10.10:::/xwiki-commons-pom/xwiki-platform/xwiki-platform-core/xwiki-platform-search/xwiki-platform-search-solr/xwiki-platform-search-solr-ui</website>
    <authors>
        <author>
            <name>XWiki Development Team</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>GNU Lesser General Public License 2.1</name>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-search-ui</id>
            <version>16.10.10</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-search-solr-api</id>
            <version>16.10.10</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-search-solr-query</id>
            <version>16.10.10</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-wiki-script</id>
            <version>16.10.10</version>
        </dependency>
        <dependency>
            <id>org.webjars:requirejs</id>
            <version>2.3.7</version>
        </dependency>
        <dependency>
            <id>org.webjars:jquery</id>
            <version>3.7.1</version>
        </dependency>
    </dependencies>
    <properties/>
</extension>
