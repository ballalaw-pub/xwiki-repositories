<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.xwiki.platform:xwiki-platform-icon-fontawesome</id>
    <version>8.4</version>
    <type>xar</type>
    <name>Font Awesome Icon Theme</name>
    <summary>Makes Font Awesome available as an Icon Theme</summary>
    <website>http://extensions.xwiki.org?id=org.xwiki.platform:xwiki-platform-icon-fontawesome:8.4:::/xwiki-commons-pom/xwiki-platform/xwiki-platform-core/xwiki-platform-icon/xwiki-platform-icon-fontawesome</website>
    <extensionfeatures>
        <feature>
            <feature>org.xwiki.platform:xwiki-platform-font-awesome</feature>
            <version>8.4</version>
        </feature>
    </extensionfeatures>
    <features>
        <feature>org.xwiki.platform:xwiki-platform-font-awesome</feature>
    </features>
    <authors>
        <author>
            <name>XWiki Development Team</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>GNU Lesser General Public License 2.1</name>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-icon-ui</id>
            <version>8.4</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-webjars-api</id>
            <version>8.4</version>
        </dependency>
        <dependency>
            <id>org.webjars:font-awesome</id>
            <version>4.2.0</version>
        </dependency>
        <dependency>
            <id>org.webjars:requirejs</id>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <id>org.webjars:jquery</id>
            <version>2.2.2</version>
        </dependency>
    </dependencies>
    <properties/>
</extension>
