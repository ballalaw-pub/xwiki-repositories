<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.xwiki.platform:xwiki-platform-distribution-flavor-common</id>
    <version>16.10.0</version>
    <type>xar</type>
    <name>XWiki Standard Common Application</name>
    <summary>Default set of wiki pages containing both content and default applications for both main and subwiki XWiki flavors</summary>
    <website>https://extensions.xwiki.org?id=org.xwiki.platform:xwiki-platform-distribution-flavor-common:16.10.0:::/xwiki-commons-pom/xwiki-platform/xwiki-platform-distribution/xwiki-platform-distribution-flavor/xwiki-platform-distribution-flavor-common</website>
    <extensionfeatures>
        <feature>
            <feature>org.xwiki.enterprise:xwiki-enterprise-ui-common</feature>
            <version>16.10.0</version>
        </feature>
        <feature>
            <feature>com.xpn.xwiki.products:xwiki-enterprise-wiki</feature>
            <version>16.10.0</version>
        </feature>
        <feature>
            <feature>org.xwiki.platform:xwiki-enterprise-wiki</feature>
            <version>16.10.0</version>
        </feature>
        <feature>
            <feature>org.xwiki.platform:xwiki-enterprise-ui</feature>
            <version>16.10.0</version>
        </feature>
        <feature>
            <feature>org.xwiki.platform:xwiki-enterprise-ui-all</feature>
            <version>16.10.0</version>
        </feature>
    </extensionfeatures>
    <features>
        <feature>org.xwiki.enterprise:xwiki-enterprise-ui-common</feature>
        <feature>com.xpn.xwiki.products:xwiki-enterprise-wiki</feature>
        <feature>org.xwiki.platform:xwiki-enterprise-wiki</feature>
        <feature>org.xwiki.platform:xwiki-enterprise-ui</feature>
        <feature>org.xwiki.platform:xwiki-enterprise-ui-all</feature>
    </features>
    <authors>
        <author>
            <name>XWiki Development Team</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>GNU Lesser General Public License 2.1</name>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-distribution-ui-base</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-dashboard-ui</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-uiextension-ui</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-attachment-picker-ui</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-ckeditor-ui</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-webjars-api</id>
            <version>16.10.0</version>
        </dependency>
    </dependencies>
    <properties/>
</extension>
