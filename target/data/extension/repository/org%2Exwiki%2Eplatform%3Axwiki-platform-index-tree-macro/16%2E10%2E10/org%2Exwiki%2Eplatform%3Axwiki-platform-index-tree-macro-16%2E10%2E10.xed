<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.xwiki.platform:xwiki-platform-index-tree-macro</id>
    <version>16.10.10</version>
    <type>xar</type>
    <name>Document Tree Macro</name>
    <summary>Macro used to display a hierarchy of XWiki documents by using a tree.</summary>
    <website>https://extensions.xwiki.org?id=org.xwiki.platform:xwiki-platform-index-tree-macro:16.10.10:::/xwiki-commons-pom/xwiki-platform/xwiki-platform-core/xwiki-platform-index/xwiki-platform-index-tree/xwiki-platform-index-tree-macro</website>
    <authors>
        <author>
            <name>XWiki Development Team</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>GNU Lesser General Public License 2.1</name>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-index-tree-api</id>
            <version>16.10.10</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-tree-macro</id>
            <version>16.10.10</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-icon-script</id>
            <version>16.10.10</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-icon-fontawesome</id>
            <version>16.10.10</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-security-authorization-script</id>
            <version>16.10.10</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-rendering-macro-velocity</id>
            <version>16.10.10</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-rendering-macro-include</id>
            <version>16.10.10</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-rendering-wikimacro-store</id>
            <version>16.10.10</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-extension-handler-xar</id>
            <version>16.10.10</version>
        </dependency>
    </dependencies>
    <properties/>
</extension>
