            <name>GNU Lesser General Public License 2.1</name>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-distribution-flavor-common</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-mail-resender-ui</id>
            <version>16.10.9</version>
        </dependency>
    </dependencies>
    <properties/>
