<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.apache.lucene:lucene-analyzers-phonetic</id>
    <version>6.2.1</version>
    <type>jar</type>
    <name>Lucene Phonetic Filters</name>
    <summary>Provides phonetic encoding via Commons Codec.</summary>
    <website>http://lucene.apache.org/lucene-parent/lucene-analyzers-phonetic</website>
    <licenses>
        <license>
            <name>Apache License 2.0</name>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <id>org.apache.lucene:lucene-analyzers-common</id>
            <version>6.2.1</version>
        </dependency>
        <dependency>
            <id>org.apache.lucene:lucene-core</id>
            <version>6.2.1</version>
        </dependency>
        <dependency>
            <id>commons-codec:commons-codec</id>
            <version>1.10</version>
        </dependency>
    </dependencies>
    <properties/>
</extension>
