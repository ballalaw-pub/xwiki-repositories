<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.xwiki.platform:xwiki-platform-tree-macro</id>
    <version>16.10.0</version>
    <type>xar</type>
    <name>Tree Macro</name>
    <summary>Provides a tree view for the structured data stored in the wiki.</summary>
    <website>https://extensions.xwiki.org?id=org.xwiki.platform:xwiki-platform-tree-macro:16.10.0:::/xwiki-commons-pom/xwiki-platform/xwiki-platform-core/xwiki-platform-tree/xwiki-platform-tree-macro</website>
    <authors>
        <author>
            <name>XWiki Development Team</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>GNU Lesser General Public License 2.1</name>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-webjars-api</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-tree-webjar</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.webjars:requirejs</id>
            <version>2.3.7</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-rendering-wikimacro-store</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-rendering-macro-velocity</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.xwiki.rendering:xwiki-rendering-macro-html</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-rendering-xwiki</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-icon-script</id>
            <version>16.10.0</version>
        </dependency>
    </dependencies>
    <properties/>
</extension>
