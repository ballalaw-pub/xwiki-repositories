            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.webjars:requirejs</id>
            <version>2.3.7</version>
        </dependency>
        <dependency>
            <id>org.webjars:jquery</id>
            <version>3.7.1</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-sheet-ui</id>
            <version>16.10.9</version>
