<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.xwiki.platform:xwiki-platform-ckeditor-ui</id>
    <version>16.10.9</version>
    <type>xar</type>
    <name>CKEditor Integration</name>
    <summary>Adds support for editing wiki pages using CKEditor.</summary>
    <website>https://extensions.xwiki.org?id=org.xwiki.platform:xwiki-platform-ckeditor-ui:16.10.9:::/xwiki-commons-pom/xwiki-platform/xwiki-platform-core/xwiki-platform-ckeditor/xwiki-platform-ckeditor-ui</website>
    <extensionfeatures>
        <feature>
            <feature>org.xwiki.contrib:application-ckeditor-ui</feature>
            <version>16.10.9</version>
        </feature>
    </extensionfeatures>
    <features>
        <feature>org.xwiki.contrib:application-ckeditor-ui</feature>
    </features>
    <authors>
        <author>
            <name>XWiki Development Team</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>GNU Lesser General Public License 2.1</name>
        </license>
    </licenses>
    <dependencies>
