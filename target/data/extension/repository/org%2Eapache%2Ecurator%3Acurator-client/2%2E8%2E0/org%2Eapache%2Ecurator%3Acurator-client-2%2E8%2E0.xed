        </license>
    </licenses>
    <dependencies>
        <dependency>
            <id>org.slf4j:slf4j-api</id>
            <version>1.7.6</version>
        </dependency>
        <dependency>
            <id>org.apache.zookeeper:zookeeper</id>
            <version>3.4.6</version>
        </dependency>
        <dependency>
            <id>com.google.guava:guava</id>
            <version>16.0.1</version>
        </dependency>
    </dependencies>
    <properties/>
</extension>
