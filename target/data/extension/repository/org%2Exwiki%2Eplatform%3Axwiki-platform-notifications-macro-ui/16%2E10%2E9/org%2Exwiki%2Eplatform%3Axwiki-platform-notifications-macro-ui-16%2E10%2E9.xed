<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.xwiki.platform:xwiki-platform-notifications-macro-ui</id>
    <version>16.10.9</version>
    <type>xar</type>
    <name>Notifications Macro</name>
    <summary>Provide a macro to embed notifications in any page or to display a stream of events.</summary>
    <website>https://extensions.xwiki.org?id=org.xwiki.platform:xwiki-platform-notifications-macro-ui:16.10.9:::/xwiki-commons-pom/xwiki-platform/xwiki-platform-core/xwiki-platform-notifications/xwiki-platform-notifications-macro/xwiki-platform-notifications-macro-ui</website>
    <authors>
        <author>
            <name>XWiki Development Team</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>GNU Lesser General Public License 2.1</name>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-notifications-script</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-notifications-rest</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-rendering-macro-velocity</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-icon-script</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.rendering:xwiki-rendering-macro-html</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-date</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-alerts-ui</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-notifications-preferences-default</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-notifications-notifiers-default</id>
            <version>16.10.9</version>
        </dependency>
    </dependencies>
    <properties/>
</extension>
