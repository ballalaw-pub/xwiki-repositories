            <name>XWiki Development Team</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>GNU Lesser General Public License 2.1</name>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-icon-script</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-icon-default</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.webjars:requirejs</id>
            <version>2.3.7</version>
        </dependency>
        <dependency>
            <id>org.webjars:jquery</id>
            <version>3.7.1</version>
        </dependency>
    </dependencies>
    <properties/>
</extension>
