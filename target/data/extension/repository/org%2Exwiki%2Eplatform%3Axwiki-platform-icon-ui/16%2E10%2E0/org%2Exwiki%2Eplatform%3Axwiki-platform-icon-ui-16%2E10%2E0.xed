<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.xwiki.platform:xwiki-platform-icon-ui</id>
    <version>16.10.0</version>
    <type>xar</type>
    <name>Icon Theme Application</name>
    <summary>Manage and display icons used all over the wiki</summary>
    <website>https://extensions.xwiki.org?id=org.xwiki.platform:xwiki-platform-icon-ui:16.10.0:::/xwiki-commons-pom/xwiki-platform/xwiki-platform-core/xwiki-platform-icon/xwiki-platform-icon-ui</website>
