<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.xwiki.platform:xwiki-platform-ckeditor-plugins</id>
    <version>16.10.0</version>
    <type>jar</type>
    <name>CKEditor Plugins for XWiki</name>
    <summary>Custom plugins that help the integration of the CKEditor in XWiki.</summary>
    <website>https://extensions.xwiki.org?id=org.xwiki.platform:xwiki-platform-ckeditor-plugins:16.10.0:::/xwiki-commons-pom/xwiki-platform/xwiki-platform-core/xwiki-platform-ckeditor/xwiki-platform-ckeditor-plugins</website>
    <extensionfeatures>
        <feature>
            <feature>org.xwiki.contrib:application-ckeditor-plugins</feature>
            <version>16.10.0</version>
        </feature>
    </extensionfeatures>
    <features>
        <feature>org.xwiki.contrib:application-ckeditor-plugins</feature>
    </features>
    <authors>
        <author>
            <name>XWiki Development Team</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>GNU Lesser General Public License 2.1</name>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <id>org.webjars:requirejs</id>
            <version>2.3.7</version>
        </dependency>
        <dependency>
            <id>org.webjars:jquery</id>
            <version>3.7.1</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-bootstrap</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-tree-webjar</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.webjars.npm:bootstrap-3-typeahead</id>
            <version>4.0.2</version>
        </dependency>
        <dependency>
            <id>org.webjars.npm:fast-diff</id>
            <version>1.3.0</version>
        </dependency>
        <dependency>
            <id>org.webjars.npm:fuse.js</id>
            <version>6.6.2</version>
        </dependency>
    </dependencies>
    <properties/>
</extension>
