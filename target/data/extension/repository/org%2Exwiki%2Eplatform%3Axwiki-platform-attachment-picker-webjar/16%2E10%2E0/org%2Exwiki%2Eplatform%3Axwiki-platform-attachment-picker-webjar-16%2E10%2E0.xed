<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.xwiki.platform:xwiki-platform-attachment-picker-webjar</id>
    <version>16.10.0</version>
    <type>jar</type>
    <name>Attachment Picker WebJar</name>
    <summary>JavaScript resources required by the attachment picker module.</summary>
    <website>https://extensions.xwiki.org?id=org.xwiki.platform:xwiki-platform-attachment-picker-webjar:16.10.0:::/xwiki-commons-pom/xwiki-platform/xwiki-platform-core/xwiki-platform-attachment/xwiki-platform-attachment-picker/xwiki-platform-attachment-picker-webjar</website>
    <authors>
        <author>
            <name>XWiki Development Team</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>GNU Lesser General Public License 2.1</name>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <id>org.webjars:requirejs</id>
            <version>2.3.7</version>
        </dependency>
        <dependency>
            <id>org.webjars:jquery</id>
            <version>3.7.1</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-search-solr-query</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-localization-webjar</id>
            <version>16.10.0</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-localization-rest-api</id>
            <version>16.10.0</version>
        </dependency>
    </dependencies>
    <properties/>
</extension>
