            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-index-tree-ui</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-rendering-macro-velocity</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.rendering:xwiki-rendering-macro-html</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-rendering-macro-include</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-rendering-wikimacro-store</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-livedata-macro</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-livedata-livetable</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-index-api</id>
