<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.xwiki.platform:xwiki-platform-index-ui</id>
    <version>16.10.9</version>
    <type>xar</type>
    <name>Index Application</name>
    <summary>An Index of all pages, attachments, orphans and deleted pages and attachments found in the wiki.</summary>
    <website>https://extensions.xwiki.org?id=org.xwiki.platform:xwiki-platform-index-ui:16.10.9:::/xwiki-commons-pom/xwiki-platform/xwiki-platform-core/xwiki-platform-index/xwiki-platform-index-ui</website>
