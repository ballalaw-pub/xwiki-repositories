<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<extension>
    <id>org.xwiki.platform:xwiki-platform-user-profile-ui</id>
    <version>16.10.9</version>
    <type>xar</type>
    <name>User Profile Application</name>
    <summary>Performs operations related to the User Profile (change preferences, user watchlist, follow users, etc)</summary>
    <website>https://extensions.xwiki.org?id=org.xwiki.platform:xwiki-platform-user-profile-ui:16.10.9:::/xwiki-commons-pom/xwiki-platform/xwiki-platform-core/xwiki-platform-user/xwiki-platform-user-profile/xwiki-platform-user-profile-ui</website>
    <extensionfeatures>
        <feature>
            <feature>org.xwiki.platform:xwiki-platform-user-ui</feature>
            <version>16.10.9</version>
        </feature>
        <feature>
            <feature>org.xwiki.contrib.membership:application-membership-profile</feature>
            <version>16.10.9</version>
        </feature>
    </extensionfeatures>
    <features>
        <feature>org.xwiki.platform:xwiki-platform-user-ui</feature>
        <feature>org.xwiki.contrib.membership:application-membership-profile</feature>
    </features>
    <authors>
        <author>
            <name>XWiki Development Team</name>
        </author>
    </authors>
    <licenses>
        <license>
            <name>GNU Lesser General Public License 2.1</name>
        </license>
    </licenses>
    <dependencies>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-rendering-macro-velocity</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-rendering-macro-include</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.rendering:xwiki-rendering-macro-html</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-attachment-ui</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.rendering:xwiki-rendering-macro-message</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-notifications-macro-ui</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-user-script</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-user-default</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-livedata-macro</id>
            <version>16.10.9</version>
        </dependency>
        <dependency>
            <id>org.xwiki.platform:xwiki-platform-livedata-livetable</id>
            <version>16.10.9</version>
        </dependency>
    </dependencies>
    <properties/>
</extension>
